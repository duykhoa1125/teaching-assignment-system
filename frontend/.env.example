# Backend port published on the host. Match BACKEND_PORT in the root .env.
# Used only by the Vite dev server; never sent to the browser bundle.
DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional: dev defaults to mock, production build defaults to api.
# VITE_DATA_SOURCE=mock
# Do not keep an explicit mock override when running build or dev:api.
