{
  "name": "tass-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "assets:auth": "node scripts/extract-demo-auth-art.mjs",
    "assets:shell": "node scripts/extract-demo-shell.mjs",
    "dev:api": "vite --mode api",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "msw": "3.0.6",
    "oxlint": "1.90.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
