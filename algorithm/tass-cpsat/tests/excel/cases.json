{
  "schemaVersion": 1,
  "description": "Small, synthetic solver acceptance fixtures derived from the teaching-assignment model and edge cases seen in the Excel workbooks. Units: periods per week; decimals have at most two places.",
  "objectiveProfile": ["unassignedCount", "totalAbsoluteDeviation", "experiencePenalty", "changedAssignments"],
  "cases": [
    {
      "id": "SOL-01",
      "title": "Unique feasible full assignment",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T2:D2"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1","D2":"T2"},"unassignedCount":0,"totalAbsoluteDeviation":0}
    },
    {
      "id": "SOL-02",
      "title": "Banned pair is never assigned",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4}],
      "eligible": ["T1:D1","T2:D1"], "banned": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T2"},"unassignedCount":0,"totalAbsoluteDeviation":4}
    },
    {
      "id": "SOL-03",
      "title": "No qualified teacher yields a partial draft",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4}], "eligible": [],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":null},"unassignedCount":1,"reason":"NO_QUALIFIED_TEACHER"}
    },
    {
      "id": "SOL-04",
      "title": "Converted load blocks an otherwise qualified assignment",
      "teachers": [{"id":"T1","B":5,"R":0,"C":3,"U":5}],
      "demands": [{"id":"D1","h":3}], "eligible": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":null},"unassignedCount":1,"reason":"CAPACITY_EXCEEDED"}
    },
    {
      "id": "SOL-05",
      "title": "Valid lock survives reoptimization",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T1:D2","T2:D1","T2:D2"], "locked": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1","D2":"T2"},"unassignedCount":0}
    },
    {
      "id": "SOL-06",
      "title": "Conflicting locks make the model infeasible",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T1:D2"], "locked": ["T1:D1","T1:D2"],
      "expected": {"status":"INFEASIBLE","reason":"LOCK_CONFLICT","preserveExistingDraft":true}
    },
    {
      "id": "SOL-07",
      "title": "Exact hard-cap boundary is allowed",
      "teachers": [{"id":"T1","B":6,"R":0,"C":2,"U":6}],
      "demands": [{"id":"D1","h":4}], "eligible": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1"},"unassignedCount":0,"loads":{"T1":{"Q":6,"W":6}}}
    },
    {
      "id": "SOL-08",
      "title": "Coverage precedes experience penalty",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T1:D2","T2:D1","T2:D2"],
      "penalties": {"T2:D1":100,"T2:D2":100},
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","unassignedCount":0,"totalAbsoluteDeviation":0,"experiencePenalty":100}
    },
    {
      "id": "SOL-09",
      "title": "Balance load across equivalent teachers",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":8},{"id":"T2","B":4,"R":0,"C":0,"U":8}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T1:D2","T2:D1","T2:D2"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","unassignedCount":0,"totalAbsoluteDeviation":0}
    },
    {
      "id": "SOL-10",
      "title": "Reduction and converted work affect distinct terms",
      "teachers": [{"id":"T1","B":8,"R":2,"C":2,"U":8}],
      "demands": [{"id":"D1","h":4}], "eligible": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1"},"unassignedCount":0,"totalAbsoluteDeviation":0,"loads":{"T1":{"Q":6,"W":6}}}
    },
    {
      "id": "SOL-11",
      "title": "Inactive teacher cannot be assigned",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4,"active":false}],
      "demands": [{"id":"D1","h":4}], "eligible": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":null},"unassignedCount":1,"reason":"NO_QUALIFIED_TEACHER"}
    },
    {
      "id": "SOL-12",
      "title": "Keep existing assignments when every higher-priority score ties",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4},{"id":"D2","h":4}],
      "eligible": ["T1:D1","T1:D2","T2:D1","T2:D2"],
      "previous": {"D1":"T1","D2":"T2"},
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1","D2":"T2"},"unassignedCount":0,"changedAssignments":0}
    },
    {
      "id": "SOL-13",
      "title": "Scale decimal periods without binary-float equality errors",
      "teachers": [{"id":"T1","B":6,"R":0,"C":1.25,"U":6}],
      "demands": [{"id":"D1","h":4.2}], "eligible": ["T1:D1"],
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1"},"unassignedCount":0,"totalAbsoluteDeviation":0.55,"loads":{"T1":{"Q":6,"W":5.45}}}
    },
    {
      "id": "SOL-14",
      "title": "Experience breaks a load-score tie",
      "teachers": [{"id":"T1","B":4,"R":0,"C":0,"U":4},{"id":"T2","B":4,"R":0,"C":0,"U":4}],
      "demands": [{"id":"D1","h":4}],
      "eligible": ["T1:D1","T2:D1"], "penalties": {"T1:D1":0,"T2:D1":3},
      "expected": {"status":"FEASIBLE_OR_OPTIMAL","assignments":{"D1":"T1"},"unassignedCount":0,"totalAbsoluteDeviation":4,"experiencePenalty":0}
    }
  ]
}
