# Dev/demo only. Copy to .env; use the same credentials for PostgreSQL and backend.
# Password changes do NOT change credentials in an already initialized volume.
POSTGRES_DB=tass
POSTGRES_USER=tass
POSTGRES_PASSWORD=tass_local_demo_change_me
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000
SOLVER_CONCURRENT_RUNS=1
SOLVER_QUEUE_CAPACITY=8
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
# Native OR-Tools uses memory outside Java heap; leave headroom for it.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50 -Dfile.encoding=UTF-8
# Isolated, disposable integration-test database (not the development volume).
TEST_DB_PASSWORD=tass_test_demo_only
